#!/bin/sh -e

prefix=${KISS_ROCM_PREFIX:-/usr/lib/rocm}
export ROCM_PATH="$prefix" HIP_PATH="$prefix" HIP_PLATFORM=amd
export HIP_CLANG_PATH="$prefix/llvm/bin"
export PATH="$prefix/llvm/bin:$prefix/bin:$PATH"
sed -i "s|^add_subdirectory(goamdsmi_shim)|if(ENABLE_ESMI_LIB)\n&\nendif()|" CMakeLists.txt
# kernel headers >=6.x already define drm_color_ctm_3x4
sed -i '/^struct drm_color_ctm_3x4 {/,/^};/d' include/amd_smi/impl/amdgpu_drm.h
# musl: PATH_MAX lives in limits.h
grep -rl PATH_MAX src | xargs sed -i '1i #include <limits.h>'

# A semicolon-separated list; use the same targets everywhere.
archs=${KISS_ROCM_ARCHS:-gfx1100}

cmake -B build -G Ninja \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_PREFIX_PATH="$prefix;$prefix/llvm" \
    -DCMAKE_INSTALL_RPATH="$prefix/lib;$prefix/llvm/lib" \
    -DCMAKE_C_COMPILER="$prefix/llvm/bin/clang" \
    -DCMAKE_CXX_COMPILER="$prefix/llvm/bin/clang++" \
    -DROCM_PATH="$prefix" \
    -DGPU_TARGETS="$archs" \
    -DAMDGPU_TARGETS="$archs" \
    -DBUILD_TESTS=OFF \
    -DBUILD_SHARED_LIBS=ON \
    -DENABLE_ESMI_LIB=OFF \
    -DBUILD_CLI=OFF \
    -DENABLE_LDCONFIG=OFF \
    -DBUILD_TESTING=OFF
cmake --build build
DESTDIR="$1" cmake --install build
