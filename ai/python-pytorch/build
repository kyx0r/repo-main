#!/bin/sh -e
export ROCM_PATH=/usr/lib/rocm
export PATH="$ROCM_PATH/bin:$PATH"
export HIP_CLANG_PATH=$ROCM_PATH/llvm/bin
export CC=$HIP_CLANG_PATH/clang CXX=$HIP_CLANG_PATH/clang++

# musl: __assert_fail takes int line and is not noexcept
sed -i "/exactly how it is in glibc/,/__noreturn__));/{s/unsigned int line,/int line,/;s/) noexcept __attr/) __attr/}" torch/headeronly/macros/Macros.h
export PYTORCH_ROCM_ARCH=gfx1100
export USE_ROCM=1 USE_CUDA=0 USE_XPU=0 BUILD_TEST=0
export USE_FLASH_ATTENTION=0 USE_MEM_EFF_ATTENTION=0
export USE_ROCM_CK_SDPA=0 USE_ROCM_CK_GEMM=0
export USE_MAGMA=0 USE_KINETO=0 USE_DISTRIBUTED=0 USE_NNPACK=0
export USE_SYSTEM_PYBIND11=1 BLAS=OpenBLAS USE_LAPACK=1
export MAX_JOBS="${MAX_JOBS:-24}"
export PYTORCH_BUILD_VERSION=2.15.0 PYTORCH_BUILD_NUMBER=1
export CMAKE_POLICY_VERSION_MINIMUM=3.5

# ROCm clang lacks libomp; use gcc libgomp
mkdir -p "$PWD/omp-inc"
cp /usr/lib/gcc/x86_64-pc-linux-musl/*/include/omp.h "$PWD/omp-inc/"
export CFLAGS="$CFLAGS -isystem $PWD/omp-inc" CXXFLAGS="$CXXFLAGS -isystem $PWD/omp-inc"
# hip host_defines.h defines __noinline__ empty, breaking libstdc++ <format>; parse it first
export CXXFLAGS="$CXXFLAGS -include chrono -include format"
for l in C CXX; do
    CMAKE_ARGS="$CMAKE_ARGS -DOpenMP_${l}_FLAGS=-fopenmp=libgomp -DOpenMP_${l}_LIB_NAMES=gomp"
done
export CMAKE_ARGS="$CMAKE_ARGS -DOpenMP_gomp_LIBRARY=/usr/lib/libgomp.so"

python tools/amd_build/build_amd.py >/dev/null

gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
python -m installer -d "$1" .dist/*.whl
