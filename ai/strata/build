#!/bin/sh -e

prefix=${KISS_ROCM_PREFIX:-/usr/lib/rocm}
export ROCM_PATH="$prefix" HIP_PATH="$prefix" HIP_PLATFORM=amd
export HIP_CLANG_PATH="$prefix/llvm/bin"
export PATH="$prefix/llvm/bin:$prefix/bin:$PATH"

patch -p1 < strata-0.1.45-hip-fixes.patch
patch -p1 < musl-execinfo.patch
patch -p1 < done-line-prompt-speed.patch
patch -p1 < inkling-done-reused.patch
patch -p1 < inkling-long-period-loop.patch

archs=${KISS_ROCM_ARCHS:-gfx1100}
# 0.2.16 split the repo: the CMake engine is engine/, the Python app (serve, strata_cli, strata_control, tools, data) is terminal/.
cmake -S engine -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_PREFIX_PATH="$prefix;$prefix/llvm" \
    -DCMAKE_C_COMPILER="$prefix/llvm/bin/clang" \
    -DCMAKE_CXX_COMPILER="$prefix/llvm/bin/clang++" \
    -DCMAKE_HIP_COMPILER="$prefix/llvm/bin/clang++" \
    -DCMAKE_HIP_COMPILER_ROCM_ROOT="$prefix" \
    -DCMAKE_HIP_ARCHITECTURES="$archs" \
    -DGPU_TARGETS="$archs" \
    -DCMAKE_INSTALL_RPATH="$prefix/lib;$prefix/llvm/lib" \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
    -DCMAKE_REQUIRE_FIND_PACKAGE_hipblaslt=ON \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DSTRATA_NATIVE_EXPERTS=ON \
    -DSTRATA_ENABLE_CUDA=OFF \
    -DSTRATA_ENABLE_HIP=ON \
    -DSTRATA_HIP_GFX906="${KISS_STRATA_GFX906:-OFF}" \
    -DSTRATA_PORTABLE="${KISS_STRATA_PORTABLE:-OFF}" \
    -DSTRATA_BUILD_TESTS=OFF

# Upstream has no install rules. Do not build/install all microbenchmarks.
cmake --build build --target strata strata-plan strata-gguf strata-dequant strata-device strata-inkling
# The engine loads <its dir>/tuning/<arch>-hipblaslt-<ver>.txt (prompt GEMMs
# via hipBLASLt); STRATA_HIPBLASLT_TABLE=off disables it.
install -Dm755 build/strata "$1/usr/lib/strata/bin/strata"
mkdir -p "$1/usr/lib/strata/bin/tuning" "$1/usr/bin"
cp terminal/tools/hip/*-hipblaslt-*.txt "$1/usr/lib/strata/bin/tuning/"
ln -s ../lib/strata/bin/strata "$1/usr/bin/strata"
for bin in strata-plan strata-gguf strata-dequant strata-device; do
    install -Dm755 "build/$bin" "$1/usr/bin/$bin"
done
install -Dm755 build/src/inkling2/strata-inkling "$1/usr/bin/strata-inkling"
install -Dm644 LICENSE "$1/usr/share/licenses/strata/LICENSE"
install -Dm644 README.md "$1/usr/share/doc/strata/README.md"

# Bundle the upstream Python server, control/CLI packages, tools and data (all under terminal/ since 0.2.16).
mkdir -p "$1/usr/lib/strata"
for d in serve strata_control strata_cli tools data; do
cp -R "terminal/$d" "$1/usr/lib/strata/$d"
done
install -Dm644 terminal/strata.py "$1/usr/lib/strata/strata.py"
install -Dm755 strata-server "$1/usr/bin/strata-server"
install -Dm644 terminal/requirements.txt "$1/usr/share/doc/strata/requirements-upstream.txt"
