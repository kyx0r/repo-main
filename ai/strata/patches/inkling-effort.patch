+def normalize_effort(value=None):
+    """A client's reasoning effort -> a value Inkling-2-Mini's chat template accepts (an effort word or 0.0-0.99)."""
+    if value is None or value == "" or value is True:
+        return DEFAULT_EFFORT
+    if value is False:
+        return "none"
+    key = str(value).strip().lower()
+    if key in EFFORT:
+        return EFFORT[key]
+    try:
+        num = float(key)
+    except ValueError:
+        return DEFAULT_EFFORT
+    if num != num:                                       # NaN
+        return DEFAULT_EFFORT
+    return "none" if num <= 0.0 else min(num, 0.99)
 
 
