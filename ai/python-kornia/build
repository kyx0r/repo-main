#!/bin/sh -e
python -m installer -d "$1" *.whl

# kornia_rs (Rust, no musl wheel) is only needed for kornia.io file I/O
sed -i 's/^from kornia_rs import io as _rs_io$/try:\n    from kornia_rs import io as _rs_io\nexcept ImportError:\n    _rs_io = None/' \
    "$1"/usr/lib/python3*/site-packages/kornia/io/io.py
