#!/bin/sh -e

prefix=${KISS_ROCM_PREFIX:-/usr/lib/rocm}
export ROCM_PATH="$prefix" HIP_PATH="$prefix" HIP_PLATFORM=amd
export HIP_CLANG_PATH="$prefix/llvm/bin"
export PATH="$prefix/llvm/bin:$prefix/bin:$PATH"
# musl: struct timeval needs sys/time.h
sed -i '1i #include <sys/time.h>' src/ras/client.cc
# musl: NULL is nullptr in C++, use literal 0 (bool for LL, pointer for Simple)
sed -i 's/work, NULL, isNetOffload/work, 0, isNetOffload/' src/device/all_gather.h
# musl: no execinfo.h (backtrace stubs: no stack dump on crash), no error.h (unused)
sed -i 's|#include <execinfo.h>|static inline int backtrace(void **b, int n) { (void)b; (void)n; return 0; }\nstatic inline char **backtrace_symbols(void *const *b, int n) { (void)b; (void)n; return 0; }|' src/misc/signals.cc
sed -i '/#include <error.h>/d' src/misc/msccl/msccl_lifecycle.cc
# musl: no dlvsym (use unversioned dlsym), no dladdr1 (dladdr's dli_fname is the same path)
sed -i 's/\bdlvsym(\([a-z_]*\), \([a-z_]*\), [A-Za-z_0-9]*)/dlsym(\1, \2)/' src/misc/ibvsymbols.cc src/misc/mlx5dvsymbols.cc src/misc/ionicdvsymbols.cc
sed -i -e 's/if (!dladdr1((void \*)mscclInternalSchedulerInit, &dl_info, (void \*\*)&link_map_ptr, RTLD_DL_LINKMAP))/if (!dladdr((void *)mscclInternalSchedulerInit, \&dl_info) || !dl_info.dli_fname)/' \
       -e 's/std::string selfLibPath = link_map_ptr->l_name;/std::string selfLibPath = dl_info.dli_fname; (void)link_map_ptr;/' src/misc/msccl/msccl_lifecycle.cc

# A semicolon-separated list; use the same targets everywhere.
archs=${KISS_ROCM_ARCHS:-gfx1100}

cmake -B build -G Ninja \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_PREFIX_PATH="$prefix;$prefix/llvm" \
    -DCMAKE_INSTALL_RPATH="$prefix/lib;$prefix/llvm/lib" \
    -DCMAKE_C_COMPILER="$prefix/llvm/bin/clang" \
    -DCMAKE_CXX_COMPILER="$prefix/llvm/bin/clang++" \
    -DROCM_PATH="$prefix" \
    -DGPU_TARGETS="$archs" \
    -DAMDGPU_TARGETS="$archs" \
    -DBUILD_TESTS=OFF \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_BFD=OFF \
    -DENABLE_MSCCLPP=OFF \
    -DENABLE_MSCCL_KERNEL=ON \
    -DROCTX=OFF \
    -DINSTALL_DEPENDENCIES=OFF \
    -DQUIET_WARNINGS=ON \
    -DBUILD_LOCAL_GPU_TARGET_ONLY=OFF \
    -DBUILD_TESTING=OFF
cmake --build build
DESTDIR="$1" cmake --install build
