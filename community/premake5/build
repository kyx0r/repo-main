#!/bin/sh -e

# Upstream attached only binary archives to the beta8 release (the
# pre-generated premake-<ver>-src.zip of beta7 is gone), so build from the
# GitHub tag tarball using the bundled bootstrap.  The old zip unpacked
# flat, the tarball wraps the tree in premake-core-<ver>/.
cd premake-core-*/

make -f Bootstrap.mak linux

mkdir -p "$1/usr/bin"
cp bin/release/premake5 "$1/usr/bin/premake5"
