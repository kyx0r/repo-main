#!/bin/sh -e

# ROCm's compiler is deliberately independent of the system LLVM/Clang.
[ "$(uname -m)" = x86_64 ] || { echo 'ROCm recipe supports x86_64 musl only' >&2; exit 1; }
prefix=${KISS_ROCM_PREFIX:-/usr/lib/rocm}
patch -p1 < musl.patch

cmake -S llvm -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$prefix/llvm" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_RPATH="$prefix/llvm/lib" \
    -DCMAKE_C_FLAGS_RELEASE="${CFLAGS:--O2} -DNDEBUG" \
    -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS:-${CFLAGS:--O2}} -DNDEBUG" \
    -DLLVM_DEFAULT_TARGET_TRIPLE="$("${CC:-cc}" -dumpmachine)" \
    -DLLVM_HOST_TRIPLE="$("${CC:-cc}" -dumpmachine)" \
    -DLLVM_ENABLE_PROJECTS='clang;lld' \
    -DLLVM_ENABLE_RUNTIMES=compiler-rt \
    -DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=ON \
    -DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON \
    -DCOMPILER_RT_BUILD_BUILTINS=ON \
    -DCOMPILER_RT_BUILD_SANITIZERS=OFF \
    -DCOMPILER_RT_BUILD_XRAY=OFF \
    -DCOMPILER_RT_BUILD_LIBFUZZER=OFF \
    -DCOMPILER_RT_BUILD_PROFILE=OFF \
    -DCOMPILER_RT_BUILD_CTX_PROFILE=OFF \
    -DCOMPILER_RT_BUILD_MEMPROF=OFF \
    -DCOMPILER_RT_BUILD_ORC=OFF \
    -DLLVM_TARGETS_TO_BUILD='X86;AMDGPU' \
    -DLLVM_ENABLE_RTTI=ON \
    -DLLVM_ENABLE_PIC=ON \
    -DLLVM_BUILD_LLVM_DYLIB=ON \
    -DLLVM_LINK_LLVM_DYLIB=ON \
    -DCLANG_LINK_CLANG_DYLIB=ON \
    -DLLVM_ENABLE_ZLIB=ON \
    -DLLVM_ENABLE_ZSTD=ON \
    -DLLVM_ENABLE_LIBXML2=OFF \
    -DLLVM_ENABLE_LIBEDIT=OFF \
    -DLLVM_ENABLE_TERMINFO=OFF \
    -DLLVM_ENABLE_FFI=OFF \
    -DLLVM_ENABLE_ASSERTIONS=OFF \
    -DLLVM_INCLUDE_TESTS=OFF \
    -DLLVM_INCLUDE_EXAMPLES=OFF \
    -DLLVM_INCLUDE_BENCHMARKS=OFF \
    -DLLVM_INCLUDE_DOCS=OFF \
    -DLLVM_INSTALL_UTILS=ON \
    -DLLVM_PARALLEL_LINK_JOBS="${KISS_ROCM_LINK_JOBS:-2}"

cmake --build build
DESTDIR="$1" cmake --install build
