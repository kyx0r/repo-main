#!/bin/sh -e

# Pure Python, and its pyproject still uses the [tool.flit.metadata] table that
# flit_core 4 rejects: install the module as it is.
site=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
mkdir -p "$1$site"
cp -R cloudpickle "$1$site/"
python -m compileall -q -s "$1" -p / "$1$site/cloudpickle"
install -Dm644 LICENSE "$1/usr/share/licenses/python-cloudpickle/LICENSE"
