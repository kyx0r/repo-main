#!/bin/sh -eu
prefix=${KISS_ROCM_PREFIX:-/usr/lib/rocm}
arch=${KISS_ROCM_TEST_ARCH:-gfx1100}
export ROCM_PATH="$prefix" HIP_PATH="$prefix" HIP_PLATFORM=amd
export HIP_CLANG_PATH="$prefix/llvm/bin"
export HIP_DEVICE_LIB_PATH="$prefix/amdgcn/bitcode"
export PATH="$prefix/bin:$prefix/llvm/bin:$PATH"
source_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
"$prefix/bin/rocminfo"
for test in hip hiprtc blas; do
    case $test in hip) libs=;; hiprtc) libs='-lhiprtc';; blas) libs='-lhipblas -lrocblas';; esac
    # Intentional splitting of the fixed library flags.
    "$prefix/bin/hipcc" --offload-arch="$arch" -O2 \
        -I"$prefix/include" -L"$prefix/lib" \
        -Wl,-rpath,"$prefix/lib" -Wl,-rpath,"$prefix/llvm/lib" \
        "$source_dir/$test-smoke.cpp" $libs -o "$work/$test"
    "$work/$test"
done
