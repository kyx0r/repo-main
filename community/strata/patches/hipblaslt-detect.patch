+#if defined(__HIPCC__) && !defined(STRATA_HIPBLASLT_AVAILABLE)
+#include <hip/hip_runtime_api.h>
+#include <string>
+// A build without hipBLASLt (cmake/hip_backend.cmake found none) runs the prompt's dense GEMMs on plain hipBLAS: say
+// so once.  Silent, it cost Gyro-L on two 7900 XTX 1.7x on prompts (903 against 1,534 tok/s, 6,345 tokens, v0.1.58).
+// Not only when STRATA_HIPBLASLT_TUNING is set: the launcher sets it only for a hipBLASLt it found, so a ROCm with no
+// hipBLASLt at all never had it set.  The cards hipBLASLt serves (gfx90a, gfx94x/95x, RDNA3/3.5/4) are told always;
+// gfx103x and older have no hipBLASLt and use the rocBLAS table instead.
+static void warn_no_hipblaslt() {
+    static std::atomic<bool> told{false};
+    if (told.load()) return;
+    const char* t = std::getenv("STRATA_HIPBLASLT_TUNING");
+    const bool table = t && *t;
+    std::string arch;
+    int dev = 0;
+    hipDeviceProp_t prop{};
+    if (hipGetDevice(&dev) == hipSuccess && hipGetDeviceProperties(&prop, dev) == hipSuccess) arch = prop.gcnArchName;
+    if (const auto c = arch.find(':'); c != std::string::npos) arch.resize(c);
+    const auto is = [&](const char* p) { return arch.rfind(p, 0) == 0; };
+    const bool lt_card = is("gfx11") || is("gfx12") || is("gfx94") || is("gfx95") || is("gfx90a");
+    if (!(table || lt_card) || told.exchange(true)) return;
+    std::fprintf(stderr, "prefill gemm: this engine was built without hipBLASLt%s: prompts on this card (%s) use plain "
+                         "hipBLAS, up to ~1.7x slower (rebuild against a ROCm with hipBLASLt)\n",
+                 table ? " (STRATA_HIPBLASLT_TUNING is ignored)" : "", arch.empty() ? "?" : arch.c_str());
+}
+#endif
