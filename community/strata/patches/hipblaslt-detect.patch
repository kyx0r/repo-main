+def fresh_if_other_hip_compiler(bdir: Path, defs) -> bool:
+    """A build folder configured with another ROCm's HIP compiler (a system ROCm without hipBLASLt, now AMD's wheels:
+    rocm_root) keeps that ROCm's package folders in its cache, hipblaslt_DIR-NOTFOUND among them.  It is configured
+    afresh, as for another generator.  True when it did."""
+    want = next((d.split("=", 1)[1] for d in defs if d.startswith("-DCMAKE_HIP_COMPILER=")), None)
+    try:
+        cache = (Path(bdir) / "CMakeCache.txt").read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return False
+    m = re.search(r"^CMAKE_HIP_COMPILER:[A-Z]+=(.*)$", cache, re.M)
+    if want is None or m is None or Path(m.group(1).strip()) == Path(want):
+        return False
+    say(f"  {Path(bdir).name}/ was configured with another ROCm ({m.group(1).strip()}), so it is configured again")
+    (Path(bdir) / "CMakeCache.txt").unlink(missing_ok=True)
+    shutil.rmtree(Path(bdir) / "CMakeFiles", ignore_errors=True)
+    return True
+
