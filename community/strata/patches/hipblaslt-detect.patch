+def rocm_hipblaslt_missing(sysroot: Path) -> bool:
+    """A system ROCm without hipBLASLt (its library or its CMake package): cmake/hip_backend.cmake then compiles the
+    prompt path's solution-table dispatch out, STRATA_HIPBLASLT_TUNING has nothing to act on and the prompt's dense
+    matrix products run on plain hipBLAS.  Gyro-L on two 7900 XTX read a 6,345-token prompt at 903 tok/s that way
+    against 1,534 with hipBLASLt and the gfx1100 table (v0.1.58)."""
+    dirs = [sysroot / d for d in ("lib", "lib64")]
+    lib = any(list(d.glob("libhipblaslt.so*")) for d in dirs)
+    pkg = any((d / "cmake" / "hipblaslt" / "hipblaslt-config.cmake").is_file() for d in dirs)
+    return not (lib and pkg)
+
